# Private MemWal publisher runtime env.
# Copy to services/server/.env.walrus-publisher and keep it private.

# Must match WALRUS_PUBLISHER_JWT_SECRET in services/server/.env.
WALRUS_PUBLISHER_JWT_SECRET=replace-with-32-byte-random-secret

# Mainnet by default. Set testnet only for a testnet publisher wallet.
SUI_NETWORK=mainnet

# Use a separate funded publisher wallet in production. It needs SUI for gas and
# WAL for storage. If you only test locally, SERVER_SUI_PRIVATE_KEY also works,
# but keeping the publisher wallet separate is safer.
PUBLISHER_SUI_PRIVATE_KEY=suiprivkey1...
# PUBLISHER_SUI_KEYSTORE_BASE64=...

# Optional Walrus publisher tuning.
# WALRUS_PUBLISHER_N_CLIENTS=4
# WALRUS_PUBLISHER_MAX_CONCURRENT_REQUESTS=4
# WALRUS_PUBLISHER_MAX_BUFFER_SIZE=8
# WALRUS_PUBLISHER_MAX_BODY_SIZE_KB=10240
# MEMWAL_PUBLISHER_METADATA_RETRY_DELAYS_MS=1000,2000,5000

# Optional override. Usually let the publisher choose the network default.
# WALRUS_PACKAGE_ID=0x...
