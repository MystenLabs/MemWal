# Server
PORT=8000
# Shared secret for Rust-to-sidecar calls. Generate a strong random value.
SIDECAR_AUTH_TOKEN=replace-with-32-byte-random-secret
# Sidecar watchdog. If the local sidecar /health fails this many consecutive
# checks, the Rust relayer exits so the platform supervisor restarts the container.
# SIDECAR_WATCHDOG_INTERVAL_SECS=30
# SIDECAR_WATCHDOG_TIMEOUT_SECS=2
# SIDECAR_WATCHDOG_MAX_FAILURES=6

# Observability
# RUST_LOG controls Rust tracing filters. Set LOG_FORMAT=json in production
# so request_id, route, status, and latency fields are machine-parseable.
RUST_LOG=memwal_server=info,tower_http=info
LOG_FORMAT=pretty
# Optional Slack incoming webhook URL. When set, the relayer alerts after a
# Walrus upload job exhausts all 5 wallet attempts without producing a blob.
# ALERT_TO_SLACK=https://hooks.slack.com/services/...

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://memwal:memwal_secret@localhost:5432/memwal

# OpenAI-compatible API (for embedding)
OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1

# Sui Network (for onchain verification)
# Controls all network-dependent defaults (RPC, Walrus, SEAL)
SUI_NETWORK=mainnet
# Legacy/localnet JSON-RPC compatibility endpoint. Testnet does not use this.
SUI_RPC_URL=https://rpc-mainnet.suiscan.xyz
# Required. Startup uses the gRPC package service to verify the configured SEAL
# policy package lineage and account::seal_approve ABI before serving requests.
SUI_GRPC_URL=https://fullnode.mainnet.sui.io:443

# Walrus Storage (publisher + aggregator)
WALRUS_PUBLISHER_URL=https://publisher.walrus-mainnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-mainnet.walrus.space
# Optional cold-read speedups. Keep WALRUS_AGGREGATOR_URL as primary; append
# region-local proxy/CDN/aggregator candidates here for tail-race reads.
# WALRUS_AGGREGATOR_URLS=https://aggregator.walrus-mainnet.h2o-nodes.com,https://aggregator.suicore.com,https://aggregator.walrus.silentvalidator.com,https://aggregator.mainnet.walrus.mirai.cloud,https://aggregator.walrus-mainnet.tududes.com
# WALRUS_AGGREGATOR_RACE_AFTER_MS=150
# Opt-in only for trusted blobs written by Walrus Memory. Disabled by default.
# WALRUS_SKIP_CONSISTENCY_CHECK=false

# Redis blob cache (SEAL ciphertext, keyed by Walrus blob ID)
# 14 days by default; set TTL or max bytes to 0 to disable blob cache use.
BLOB_CACHE_TTL_SECS=1209600
BLOB_CACHE_MAX_BYTES=524288

# Server wallet (deployer = TEE admin) — required for SEAL decrypt
SERVER_SUI_PRIVATE_KEY=suiprivkey1...

# Key pool for parallel Walrus uploads (up to 5 wallets round-robin)
# Each wallet needs SUI + WAL tokens
SERVER_SUI_PRIVATE_KEYS=suiprivkey1...,suiprivkey1...

# Contract IDs — required. MEMWAL_PACKAGE_ID is the immutable original-publish
# (Move type-origin) package ID; never replace it with an upgraded package ID.
MEMWAL_PACKAGE_ID=0x...
# Executable package containing the current account::seal_approve policy.
# Defaults to MEMWAL_PACKAGE_ID; set it to published-at after a package upgrade.
MEMWAL_SEAL_POLICY_PACKAGE_ID=0x...
MEMWAL_REGISTRY_ID=0x...
# Normal relayers leave these unset. Only dedicated, authenticated migration
# sidecars enable the inactive-account route or legacy two-argument ABI.
#SIDECAR_ENABLE_MIGRATION_SEAL_ROUTE=true
#SIDECAR_ENABLE_LEGACY_SEAL_ABI=true

# SEAL server configs for sidecar encrypt/decrypt.
# If neither SEAL_SERVER_CONFIGS nor SEAL_KEY_SERVERS is set, the sidecar uses
# built-in defaults for SUI_NETWORK. Testnet keeps the original Mysten
# independent key server pair so older encrypted memories remain decryptable.
# Mainnet also uses its legacy independent key server default until an official
# mainnet committee aggregator is available.
#
# Use SEAL_SERVER_CONFIGS to opt into a committee key server. Committee entries
# require an aggregatorUrl. Example Mysten testnet committee:
# SEAL_SERVER_CONFIGS=[{"objectId":"0xb012378c9f3799fb5b1a7083da74a4069e3c3f1c93de0b27212a5799ce1e1e98","weight":1,"aggregatorUrl":"https://seal-aggregator-testnet.mystenlabs.com"}]
# The Mysten committee is 3-of-5 internally, but Seal exposes it as one logical
# server config. Leave SEAL_THRESHOLD unset or set it to 1 when using this
# committee config. Do not switch existing deployments until older data is
# migrated or re-encrypted.
#
# Explicit legacy independent key server override:
# SEAL_KEY_SERVERS=0x73d05d62c18d9374e3ea529e8e0ed6161da1a141a94d3f76ae3fe4e99356db75,0xf5d14a81a982144ae441cd7d64b09027f116a468bd36e7eca494f750591623c8
#
# Existing testnet deployments can omit SEAL_KEY_SERVERS and still use the
# built-in default above; pin it explicitly if you want to guard against future
# default changes.

# SEAL threshold - minimum configured server weight that must respond for
# encrypt/decrypt to succeed. Must be <= total configured server weight.
# Default: min(2, total configured weight).
# SEAL_THRESHOLD=2

# Walrus on-chain package ID (auto-detected from SUI_NETWORK if not set)
# WALRUS_PACKAGE_ID=0x...
# Walrus shared System object used to build delete_blob PTBs.
# WALRUS_SYSTEM_OBJECT_ID=0x...

# Security delete (legacy Seal-exposure remediation)
# Master enables deletion UI/API visibility. Selector switches legacy endpoints
# off and the backend-built v2 routes on; never exposes both route families.
# ENABLE_MEMORY_DELETION=false
# ENABLE_SECURITY_DELETE=false
# Legacy old-V1 database. Required by selector or either background job.
# LEGACY_DB_URL=postgresql://memwal:memwal_secret@localhost:5432/memwal_legacy
# DELETION_OBJECT_RESOLVER_ENABLED=false
# DELETION_RECONCILER_ENABLED=false
# DELETE_BATCH_MAX=900
# MAX_ACTIVE_BATCHES_PER_OWNER=16
# SECURITY_DELETE_AUTH_REQUESTS_PER_MINUTE=20
# SECURITY_DELETE_PREPARE_REQUESTS_PER_MINUTE=10
# Deletion PTBs all mutate the Walrus System shared object. This process-local
# gate is shared by API submit and reconciler replay; coordinate the aggregate
# separately when multiple replicas execute deletions.
# SECURITY_DELETE_EXECUTE_MAX_IN_FLIGHT=1
# Localnet load-test only. Leave unset in every production deployment.
# SECURITY_DELETE_CRASH_TEST_SECRET=
# Strict per-process rolling-window quota for security-deletion Sui calls.
# Divide an account-wide provider quota across replicas.
# SUI_RPC_REQUESTS_PER_WINDOW=3000
# SUI_RPC_WINDOW_SECS=10
# SUI_RPC_QUOTA_UTILIZATION=0.95 # applies to rolling-window mode only
# Hard deadline for each gRPC attempt and process-wide concurrency ceiling.
# Background jobs cannot consume the final 5% of the rolling quota or final
# 10% of in-flight capacity, keeping interactive deletion responsive.
# SUI_RPC_ATTEMPT_TIMEOUT_MS=5000
# SUI_RPC_MAX_IN_FLIGHT=64
# Deprecated compatibility fallback: SUI_RPC_MAX_RPS=N preserves evenly spaced RPS.
# SPONSOR_PRIVATE_KEY=<base64-encoded-32-byte-ed25519-secret>
# SPONSOR_MIN_BALANCE_ALERT=1000000000
# CLAIM_TTL_SECS=600
# EXEC_GRACE_SECS=120
# DELETION_TOKEN_SECRET=<strong-random-secret>
# DELETION_TOKEN_TTL_SECS=2700
# EXPIRY_MARGIN_EPOCHS=1

# Walrus upload relay (auto-detected from SUI_NETWORK if not set)
# WALRUS_UPLOAD_RELAY_URL=https://upload-relay.mainnet.walrus.space
# Number of Walrus storage epochs requested for new uploads.
# Mainnet default is 3; sidecar caps this at 5 to avoid accidental large spends.
# WALRUS_STORAGE_EPOCHS=3
# Refresh long-lived Walrus SDK/relay-tip cache so epoch/relay changes do not require redeploy.
# WALRUS_CLIENT_MAX_AGE_MS=1800000
# UPLOAD_RELAY_TIP_CACHE_TTL_MS=300000

# Enoki Sponsored Transactions (sidecar)
ENOKI_API_KEY=
ENOKI_NETWORK=mainnet
# Keep false in production so missing/expired/rejected sponsorship retries
# through Apalis instead of making the server wallet pay gas directly.
ENOKI_FALLBACK_TO_DIRECT_SIGN=false
# Retry transient Enoki HTTP failures (429/5xx/network) inside the sidecar
# before consuming a durable wallet-job retry.
ENOKI_TRANSIENT_MAX_ATTEMPTS=2
ENOKI_TRANSIENT_BASE_DELAY_MS=5000
ENOKI_TRANSIENT_MAX_DELAY_MS=30000
# Retry Enoki-sponsored tx invalidation (`expired`) and short Sui object
# visibility lag before consuming a durable wallet-job retry.
ENOKI_INVALIDATED_MAX_ATTEMPTS=4
ENOKI_INVALIDATED_BASE_DELAY_MS=1000
ENOKI_INVALIDATED_MAX_DELAY_MS=8000

# Sponsor endpoint rate limiting (per IP plus a server-controlled global cap)
SPONSOR_RATE_LIMIT_PER_MINUTE=10
SPONSOR_RATE_LIMIT_PER_HOUR=30
SPONSOR_GLOBAL_RATE_LIMIT_PER_MINUTE=100
SPONSOR_GLOBAL_RATE_LIMIT_PER_HOUR=1000

# Number of trusted reverse proxies between clients and this process. Default
# 0 ignores X-Forwarded-For and uses the TCP peer. Set to 1 on Railway only
# when its ingress is the sole trusted hop that appends/sanitizes XFF.
# TRUSTED_PROXY_HOPS=1

# CORS — comma-separated list of allowed browser origins
# If unset, CORS is deny-all (browsers blocked) — always set this in production
#
# Production:
# ALLOWED_ORIGINS=https://memwal.ai,https://noter.demo.memwal.ai,https://chatbot.demo.memwal.ai,https://researcher.demo.memwal.ai
#
# Staging:
# ALLOWED_ORIGINS=https://staging.memwal.ai,https://noter.demo.staging.memwal.ai,https://chatbot.demo.staging.memwal.ai,https://researcher.demo.staging.memwal.ai
#
# Local dev:
ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────
# Benchmark mode (RAG-quality benchmarks only — see benchmarks/README.md)
# ─────────────────────────────────────────────────────────────────────
# All three below are for the benchmark harness and MUST stay unset / off
# in production. BENCHMARK_MODE swaps storage to the PlaintextEngine
# (memories stored UNENCRYPTED in Postgres, bypassing SEAL + Walrus).
#
# BENCHMARK_MODE=true
#
# Bypass all request-rate buckets so parallel benchmark workers don't get
# 429s. Storage quota + auth still apply. Logs a loud warning at startup.
# Simpler than tuning the three RATE_LIMIT_* numbers individually.
# RATE_LIMIT_DISABLED=1
#
# Alternatively, raise the individual limits instead of full bypass:
# RATE_LIMIT_REQUESTS_PER_MINUTE=100000
# RATE_LIMIT_REQUESTS_PER_HOUR=1000000
# RATE_LIMIT_DELEGATE_KEY_PER_MINUTE=100000

# ─────────────────────────────────────────────────────────────────────
# Balance Monitoring (Proactive Alerts)
# ─────────────────────────────────────────────────────────────────────
# Interval in seconds for checking wallet balances (default 900 = 15 min)
# BALANCE_MONITOR_INTERVAL_SECS=900
# Alert threshold for uploader pool WAL balance in frost units (default 1M)
# WALLET_BALANCE_LOW_THRESHOLD_WAL=1000000
# Alert threshold for sponsor wallet SUI balance in mist units (default 100M)
# SPONSOR_BALANCE_LOW_THRESHOLD_SUI=100000000
