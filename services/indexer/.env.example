# Database (same PostgreSQL as server — shared instance)
DATABASE_URL=postgresql://memwal:memwal_secret@localhost:5432/memwal

# Static checkpoint ingestion. The testnet image defaults are shown here.
# Mainnet deployments MUST override both values; choose a first checkpoint
# before the target package was published.
INDEXER_REMOTE_STORE_URL=https://checkpoints.testnet.sui.io
INDEXER_FIRST_CHECKPOINT=360074900

# Walrus Memory contract package ID (for event filtering)
MEMWAL_PACKAGE_ID=0xcf6ad755a1cdff7217865c796778fabe5aa399cb0cf2eba986f4b582047229c6
