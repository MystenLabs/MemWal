# Database (same PostgreSQL as server — shared instance)
DATABASE_URL=postgresql://memwal:memwal_secret@localhost:5432/memwal

# Walrus Memory contract package ID (filters AccountCreated events)
MEMWAL_PACKAGE_ID=0xcf6ad755a1cdff7217865c796778fabe5aa399cb0cf2eba986f4b582047229c6

# Log level (the framework installs its own tracing subscriber, honors RUST_LOG)
RUST_LOG=info

# ── Ingestion is configured via CLI args, not env (clap) ──────────────
# The checkpoint remote store + start checkpoint are passed on the command line:
#   --remote-store-url https://checkpoints.testnet.sui.io   (mainnet: .../mainnet.sui.io)
#   --first-checkpoint <N>   # only on a fresh watermark; use the package deploy
#                            # checkpoint for a full backfill, near-tip for new-only
