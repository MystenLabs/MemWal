# Optional. When unset, the benchmark uses the deterministic mock Jev client.
# TYPESAFE_API_KEY=sk-...

# Pinned model for real API calls (do not use jev-latest in experiments).
JEV_MODEL=jev-1.13.0

# Optional override of the TypeSafe endpoint.
# TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
