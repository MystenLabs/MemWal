# ══════════════════════════════════════════════════════════════
# Walrus Memory App — Environment Configuration
# ══════════════════════════════════════════════════════════════
# To switch networks: uncomment one block, comment out the other.
# ══════════════════════════════════════════════════════════════

# Enoki zkLogin — enables "Sign in with Google"
# Get Enoki API key from https://portal.enoki.mystenlabs.com
VITE_ENOKI_API_KEY=enoki_public_9aac56cf5c1e5b1254d1fa09bb6e9f0c

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=386692102434-pn0enkrr12r5q3arflsfrrvb14rvhs10.apps.googleusercontent.com

# Walrus Memory Server URL (also handles /sponsor and /sponsor/execute for gasless tx)
VITE_MEMWAL_SERVER_URL=https://relayer.dev.memwal.ai

# Master switch for deletion UI, then selector for the backend-built security-delete flow.
VITE_ENABLE_MEMORY_DELETION=false
VITE_SECURITY_DELETE_ENABLED=false

# Docs URL (separate deployment)
VITE_DOCS_URL=http://localhost:5174
VITE_TERMS_OF_SERVICE_URL=https://docs.wal.app/docs/legal/walrus_general_tos
VITE_PRIVACY_POLICY_URL=https://docs.wal.app/docs/legal/privacy

# Demo app links (comma-separated, format: Label|URL)
# Example: VITE_DEMO_URLS=Chat Demo|https://chat.example.com,Agent Demo|https://agent.example.com
VITE_DEMO_URLS=

# Google Analytics 4 Measurement ID. Leave blank to disable analytics.
VITE_GA_MEASUREMENT_ID=

# Google Tag Manager Container ID. Set to GTM-KPDDH5DX in production.
VITE_GTM_CONTAINER_ID=

# Analytics only sends on these production hosts. Applies to GTM, GA4, and PostHog.
# Use * for local analytics testing.
VITE_ANALYTICS_ALLOWED_HOSTS=walrus.xyz,www.walrus.xyz

# PostHog Project API key. Leave blank to disable PostHog.
VITE_POSTHOG_PROJECT_API_KEY=
VITE_POSTHOG_HOST=https://t.walrus.xyz
VITE_POSTHOG_UI_HOST=https://us.posthog.com

# ══════════════════════════════════════════════════════════════
# ▷ INACTIVE: MAINNET  (uncomment below, comment out TESTNET above)
# ══════════════════════════════════════════════════════════════
# VITE_SUI_NETWORK=mainnet
# Required Sui RPC v2 gRPC-Web endpoint. There is no JSON-RPC fallback.
# VITE_SUI_GRPC_URL=https://fullnode.mainnet.sui.io:443
# VITE_MEMWAL_PACKAGE_ID=0xcee7a6fd8de52ce645c38332bde23d4a30fd9426bc4681409733dd50958a24c6
# VITE_MEMWAL_REGISTRY_ID=0x0da982cefa26864ae834a8a0504b904233d49e20fcc17c373c8bed99c75a7edd

# ══════════════════════════════════════════════════════════════
# ▶ ACTIVE: TESTNET
# ══════════════════════════════════════════════════════════════
VITE_SUI_NETWORK=testnet
VITE_SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
VITE_MEMWAL_PACKAGE_ID=0xcf6ad755a1cdff7217865c796778fabe5aa399cb0cf2eba986f4b582047229c6
VITE_MEMWAL_REGISTRY_ID=0xe80f2feec1c139616a86c9f71210152e2a7ca552b20841f2e192f99f75864437

# ══════════════════════════════════════════════════════════════
# ▷ CUTOVER: legacy deployment ids for the security-delete surface.
# The exposed blobs were Seal-encrypted under the PRE-cutover package, and
# Seal decryption is package-bound (identity namespace, seal_approve policy,
# Account object type) — once VITE_MEMWAL_PACKAGE_ID points at the NEW
# package, set these to the OLD deployment so previews keep decrypting
# (the app-side analogue of the relayer's LEGACY_DB_URL). Unset, each falls
# back to its current-deployment counterpart — no change pre-cutover.
# ══════════════════════════════════════════════════════════════
# VITE_LEGACY_MEMWAL_PACKAGE_ID=
# VITE_LEGACY_MEMWAL_REGISTRY_ID=
# VITE_LEGACY_SEAL_KEY_SERVERS=

# Security-upgrade banner: target of the "guide to removing data" link.
# Defaults to the in-page deletion section (#cleanup).
# VITE_SECURITY_GUIDE_URL=

# ══════════════════════════════════════════════════════════════
# ▷ OPTIONAL: point a "testnet"-labelled build at a custom Sui/Seal/Walrus
# deployment (e.g. a local devstack) instead of the real network — used by
# apps/app/e2e's Playwright suite. JSON-RPC requires the explicit local-only
# flag; never enable it in a deployed testnet build.
# ══════════════════════════════════════════════════════════════
# VITE_SUI_RPC_URL=
# VITE_SUI_LOCAL_E2E_JSON_RPC=true
# VITE_SEAL_KEY_SERVERS=<comma-separated Seal KeyServer object ids>
# VITE_WALRUS_AGGREGATOR_URL=<aggregator base URL — see utils/blobPreview.ts>
